---
// src/components/ArticleView.astro
import Layout from '../layouts/Layout.astro';
import Button from './Button.astro';
import { blogPosts, type BlogPost } from '../data/blogPosts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const otherPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<Layout
    title={`${post.title} - Blog Documentalista`}
    description={post.excerpt}
>
    <main class="article-page">
        <article class="article-container">
            <!-- Navegação e Voltar -->
            <div class="article-nav">
                <a href="/blog" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i> Voltar para todos os artigos
                </a>

                <nav class="breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Início</a>
                    <span>/</span>
                    <a href="/blog">Blog</a>
                    <span>/</span>
                    <span class="breadcrumb-current">{post.category}</span>
                </nav>
            </div>

            <!-- Cabeçalho do Artigo -->
            <header class="article-header">
                <span class="article-category">{post.category}</span>
                <h1 class="article-title">{post.title}</h1>

                <div class="article-meta">
                    <div class="meta-item author">
                        <div class="author-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <span>Por <strong>{post.author}</strong></span>
                    </div>
                    <span class="meta-divider">•</span>
                    <div class="meta-item">
                        <i class="fa-regular fa-calendar"></i>
                        <span>{post.date}</span>
                    </div>
                    <span class="meta-divider">•</span>
                    <div class="meta-item">
                        <i class="fa-regular fa-clock"></i>
                        <span>{post.readTime}</span>
                    </div>
                </div>
            </header>

            <!-- Imagem de Destaque -->
            <figure class="article-featured-image">
                <img src={post.image} alt={post.title} />
            </figure>

            <!-- Corpo do Artigo -->
            <div class="article-body" set:html={post.content} />

            <!-- Tags -->
            {post.tags && post.tags.length > 0 && (
                <div class="article-tags">
                    <span class="tags-label"><i class="fa-solid fa-tags"></i> Tags:</span>
                    <div class="tags-list">
                        {post.tags.map((tag) => (
                            <span class="tag-chip">#{tag}</span>
                        ))}
                    </div>
                </div>
            )}

            <!-- Autor Box -->
            <div class="author-card">
                <div class="author-card-avatar">
                    <i class="fa-solid fa-user-tie"></i>
                </div>
                <div class="author-card-info">
                    <h3>{post.author}</h3>
                    <p>
                        Especialista no mercado veicular e tecnologia para despachantes de veículos e vistorias. Dedicado a simplificar rotinas burocráticas através de soluções digitais.
                    </p>
                </div>
            </div>

            <!-- CTA no Artigo -->
            <div class="article-cta-box">
                <div class="cta-inner">
                    <div class="cta-badge">
                        <i class="fa-solid fa-rocket"></i> EXPERIMENTE O DOCUMENTALISTA
                    </div>
                    <h2>Pronto para otimizar a gestão do seu escritório?</h2>
                    <p>
                        Junte-se a centenas de despachantes que controlam ordens de serviço, emissões e finanças em tempo recorde.
                    </p>
                    <div class="cta-actions">
                        <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">
                            Testar 15 dias grátis <i class="fa-solid fa-arrow-right"></i>
                        </Button>
                        <Button href="https://wa.me/5547991278324" target="_blank" variant="outline">
                            Conversar com especialista
                        </Button>
                    </div>
                </div>
            </div>

            <!-- Outros Artigos Relacionados -->
            {otherPosts.length > 0 && (
                <section class="related-section">
                    <h2>Leia também</h2>
                    <div class="related-grid">
                        {otherPosts.map((item) => (
                            <a href={`/blog/${item.slug}`} class="related-card">
                                <div class="related-media">
                                    <img src={item.image} alt={item.title} loading="lazy" />
                                    <span class="related-category">{item.category}</span>
                                </div>
                                <div class="related-info">
                                    <span class="related-date"><i class="fa-regular fa-calendar"></i> {item.date}</span>
                                    <h3>{item.title}</h3>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}
        </article>
    </main>
</Layout>

<style>
    .article-page {
        padding-top: 7rem;
        padding-bottom: 5rem;
        position: relative;
        z-index: 1;
    }

    .article-container {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* Navegação */
    .article-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: transform 0.3s ease, color 0.3s ease;
    }

    .back-link:hover {
        transform: translateX(-4px);
        color: var(--color-secondary);
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .breadcrumb a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
        color: var(--color-secondary);
    }

    .breadcrumb-current {
        color: var(--color-primary);
        font-weight: 600;
    }

    /* Cabeçalho */
    .article-header {
        margin-bottom: 2.5rem;
    }

    .article-category {
        display: inline-block;
        background: rgba(61, 181, 180, 0.12);
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        margin-bottom: 1rem;
        border: 1px solid rgba(61, 181, 180, 0.25);
    }

    .article-title {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.25;
        color: var(--color-secondary);
        margin-bottom: 1.25rem;
    }

    .article-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8rem;
        font-size: 0.9rem;
        color: var(--text-muted);
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(18, 74, 110, 0.1);
    }

    .article-meta .meta-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .article-meta i {
        color: var(--color-primary);
    }

    .author-avatar {
        width: 28px;
        height: 28px;
        background: rgba(18, 74, 110, 0.1);
        color: var(--color-secondary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
    }

    .meta-divider {
        color: #cbd5e1;
    }

    /* Imagem Destaque */
    .article-featured-image {
        margin: 0 0 3rem 0;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(18, 74, 110, 0.08);
    }

    .article-featured-image img {
        width: 100%;
        max-height: 480px;
        object-fit: cover;
        display: block;
    }

    /* Corpo de Conteúdo */
    .article-body {
        font-size: 1.125rem;
        line-height: 1.85;
        color: #334155;
    }

    .article-body :global(p.lead) {
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.7;
        color: var(--color-secondary);
        margin-bottom: 2rem;
    }

    .article-body :global(h2) {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--color-secondary);
        margin-top: 2.75rem;
        margin-bottom: 1rem;
        line-height: 1.35;
    }

    .article-body :global(h3) {
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--color-secondary);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .article-body :global(p) {
        margin-bottom: 1.5rem;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
        margin: 1.5rem 0;
        padding-left: 1.75rem;
    }

    .article-body :global(li) {
        margin-bottom: 0.75rem;
        line-height: 1.75;
    }

    .article-body :global(strong) {
        color: var(--color-secondary);
        font-weight: 700;
    }

    .article-body :global(blockquote) {
        margin: 2.5rem 0;
        padding: 1.75rem 2rem;
        background: rgba(61, 181, 180, 0.08);
        border-left: 4px solid var(--color-primary);
        border-radius: 0 1rem 1rem 0;
        font-size: 1.2rem;
        font-style: italic;
        color: var(--color-secondary);
        line-height: 1.6;
    }

    /* Tags */
    .article-tags {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(18, 74, 110, 0.1);
    }

    .tags-label {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--color-secondary);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .tags-list {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tag-chip {
        background: #f1f5f9;
        color: #475569;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
    }

    /* Card Autor */
    .author-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        background: #ffffff;
        border-radius: 1.25rem;
        padding: 2rem;
        margin-top: 2.5rem;
        border: 1px solid rgba(18, 74, 110, 0.1);
        box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.05);
    }

    .author-card-avatar {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .author-card-info h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-secondary);
        margin-bottom: 0.35rem;
    }

    .author-card-info p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--text-muted);
        margin: 0;
    }

    /* CTA Box */
    .article-cta-box {
        margin: 4rem 0 3rem 0;
        background: linear-gradient(135deg, #124A6E 0%, #0F3D5A 100%);
        border-radius: 1.5rem;
        padding: 3.5rem 2.5rem;
        text-align: center;
        color: #ffffff;
        box-shadow: 0 25px 50px -15px rgba(18, 74, 110, 0.3);
    }

    .cta-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(61, 181, 180, 0.2);
        color: #3DB5B4;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding: 0.4rem 1.2rem;
        border-radius: 9999px;
        margin-bottom: 1.2rem;
    }

    .article-cta-box h2 {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 1rem;
        color: #ffffff;
    }

    .article-cta-box p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.85);
        max-width: 620px;
        margin: 0 auto 2rem auto;
    }

    .cta-actions {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .cta-actions :global(.btn-outline) {
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff;
    }

    .cta-actions :global(.btn-outline:hover) {
        border-color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }

    /* Relacionados */
    .related-section {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid rgba(18, 74, 110, 0.1);
    }

    .related-section h2 {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--color-secondary);
        margin-bottom: 2rem;
    }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.75rem;
    }

    .related-card {
        background: #ffffff;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid rgba(18, 74, 110, 0.08);
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .related-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.1);
        border-color: rgba(61, 181, 180, 0.4);
    }

    .related-media {
        position: relative;
        height: 150px;
        overflow: hidden;
    }

    .related-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .related-card:hover .related-media img {
        transform: scale(1.08);
    }

    .related-category {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        background: rgba(18, 74, 110, 0.9);
        color: #ffffff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
    }

    .related-info {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .related-date {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .related-card h3 {
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.4;
        color: var(--color-secondary);
        margin: 0;
        transition: color 0.3s ease;
    }

    .related-card:hover h3 {
        color: var(--color-primary);
    }

    /* Responsividade */
    @media (max-width: 768px) {
        .article-title {
            font-size: 1.95rem;
        }

        .related-grid {
            grid-template-columns: 1fr;
        }

        .author-card {
            flex-direction: column;
            text-align: center;
        }

        .article-cta-box {
            padding: 2.5rem 1.5rem;
        }

        .article-cta-box h2 {
            font-size: 1.6rem;
        }
    }
</style>
