---
// src/components/Header.astro
import Button from './Button.astro';
---

<header class="header" id="header">
    <div class="container header-inner">
        <a href="/" class="logo" aria-label="DOCUMENTALISTA Home">
            <img src="/assets/images/logo.svg" alt="DOCUMENTALISTA Logo" style="width: 250px; height: auto;">
        </a>

        <nav class="nav-menu" aria-label="Main Navigation">
            <a href="/#funcionalidades" class="nav-link">Recursos</a>
            <a href="/#diferenciais" class="nav-link">Diferenciais</a>
            <a href="/#depoimentos" class="nav-link">Depoimentos</a>
            <a href="/#faq" class="nav-link">FAQ</a>
            <a href="/#planos" class="nav-link">Planos</a>
        </nav>

        <div class="header-actions">
            <Button href="https://app.documentalista.com.br/" target="_blank" variant="outline">Entrar</Button>
            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Teste 15 dias grátis</Button>
        </div>

        <button class="mobile-toggle" aria-label="Abrir menu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
</header>
