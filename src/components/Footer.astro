---
// src/components/Footer.astro
---

<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <!-- Column 1: Brand & Social -->
            <div class="footer-col brand-col">
                <a href="/" class="logo" style="color: #fff; font-weight: 700; font-size: 1.5rem; text-decoration: none;">DOCUMENTALISTA</a>
                <p>O sistema online simples e eficiente feito para facilitar a vida e o dia a dia dos Despachantes de Veículos e empresas de Vistoria.</p>
                <div class="social-links">
                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                </div>
            </div>

            <!-- Column 2: Links -->
            <div class="footer-col">
                <h3>Produto</h3>
                <ul>
                    <li><a href="/#funcionalidades">Recursos</a></li>
                    <li><a href="/#diferenciais">Diferenciais</a></li>
                    <li><a href="/#planos">Planos e Preços</a></li>
                    <li><a href="/#faq">Perguntas Frequentes</a></li>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="https://documentalista.com.br/politica-de-privacidade-documentalista/" target="_blank">Política de Privacidade</a></li>
                </ul>
            </div>

            <!-- Column 3: Certifications -->
            <div class="footer-col cert-col">
                <h3>Certificações</h3>
                <div class="cert-grid">
                    <div class="cert-badge">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>100%<br>LGPD</span>
                    </div>
                    <div class="cert-badge">
                        <i class="fa-solid fa-lock"></i>
                        <span>SSL<br>256-bit</span>
                    </div>
                    <div class="cert-badge">
                        <i class="fa-solid fa-server"></i>
                        <span>AWS<br>Cloud</span>
                    </div>
                    <div class="cert-badge">
                        <i class="fa-solid fa-file-contract"></i>
                        <span>Seguro<br>& Confiável</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 Documentalista. Todos os direitos reservados.</p>
            <p>Feito com 💙 para Despachantes de Veículos.</p>
        </div>
    </div>
</footer>
