        <!-- App Section -->
        <section id="aplicativo" class="app-section">
            <div class="container">

                <div class="app-header scroll-anim">
                    <span class="feature-badge"><i class="fa-solid fa-laptop"></i> SISTEMA PARA DESPACHANTES</span>
                    <h2>Acessível de qualquer lugar</h2>
                    <p>Um conjunto de recursos incríveis para a gestão do seu escritório de despachante. Priorizamos a
                        simplicidade, para que o foco esteja no crescimento do seu negócio.</p>
