---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout>
    <main>
        <!-- Hero Section -->
        <section class="hero" id="home">
            <div class="container hero-grid">

                <!-- Left Content -->
                <div class="hero-content">

                    <h1 class="g-fade-up g-delay-1">
                        Sistema Online para <span class="gradient-text">Despachantes de Veículos</span> e Vistorias.
                    </h1>

                    <p class="subheadline g-fade-up g-delay-2">
                        O Documentalista é um sistema online simples e eficiente feito para facilitar a vida e o dia-a-dia dos Despachantes de Veículos e empresas de Vistoria.
                    </p>

                    <div class="hero-ctas g-fade-up g-delay-3">
                        <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="secondary">
                            Experimente 15 dias grátis <i class="fa-solid fa-arrow-right"></i>
                        </Button>
                        <Button href="https://wa.me/5547991278324" target="_blank" variant="outline">
                            Conversar com especialista
                        </Button>
                    </div>

                    <div class="trust-box g-fade-up g-delay-4">
                        <div class="trust-item">
                            <i class="fa-solid fa-check-circle"></i> 15 Dias grátis para testar
                        </div>
                        <div class="trust-item">
                            <i class="fa-solid fa-check-circle"></i> Sem cartão de crédito
                        </div>
                        <div class="trust-item">
                            <i class="fa-solid fa-check-circle"></i> Cancelamento livre
                        </div>
                    </div>
                </div>

                <!-- Right Visual -->
                <div class="hero-visual-container">
                    <div class="hero-visual g-fade-in g-delay-5">
                        <div class="image-wrapper" data-tilt data-tilt-max="5" data-tilt-speed="400"
                            data-tilt-perspective="1000">
                            <img src="/assets/images/Deskto-hero-documentalista.png"
                                alt="Interface do sistema DOCUMENTALISTA em um notebook" width="800" height="600">
                        </div>

                        <!-- Selo de Experiência -->
                        <div class="hero-experience-badge">
                            <div class="badge-icon-gold">
                                <i class="fa-solid fa-award"></i>
                            </div>
                            <div class="badge-text-content">
                                <strong>+10 Anos de Experiência</strong>
                                <span>no mercado de despachantes</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Features Section (Abas & Tópicos Estilo ClickGarage) -->
        <section id="funcionalidades" class="features-section">
            <div class="container">
                <div class="features-header scroll-anim text-center" style="margin-bottom: 2.5rem; text-align: center;">
                    <h2>Projetado para as suas necessidades</h2>
                    <p class="subheadline" style="max-width: 720px; margin: 0.8rem auto 0 auto;">
                        Desenvolvemos o Documentalista pensando em tudo o que você precisa para fazer a gestão completa do seu escritório de despachante e vistorias.
                    </p>
                </div>

                <!-- Abas de Navegação -->
                <div class="features-tabs-nav scroll-anim">
                    <button class="tab-btn active" data-tab="tab-cadastros">Cadastros</button>
                    <button class="tab-btn" data-tab="tab-os">Ordens de Serviço</button>
                    <button class="tab-btn" data-tab="tab-documentos">Documentos & Recibos</button>
                    <button class="tab-btn" data-tab="tab-financeiro">Financeiro</button>
                    <button class="tab-btn" data-tab="tab-relatorios">Relatórios</button>
                    <button class="tab-btn" data-tab="tab-seguranca">Consulta Veicular</button>
                </div>

                <!-- Painéis de Conteúdo das Abas -->
                <div class="tab-content-container">
                    <!-- Tab 1: Cadastros -->
                    <div class="tab-panel active" id="tab-cadastros">
                        <div class="tab-text-side">
                            <h3>🚗 Gestão de Clientes & Veículos</h3>
                            <p>
                                Oferecemos uma área intuitiva para gestão de clientes e veículos com recursos exclusivos, proporcionando <strong>maior controle, organização e agilidade</strong>. Faça consultas rápidas e acompanhe todo o histórico em um só lugar.
                            </p>
                            <ul class="tab-topics-list">
                                <li><i class="fa-solid fa-circle-check"></i> Cadastro simples e rápido por Placa ou CPF/CNPJ</li>
                                <li><i class="fa-solid fa-circle-check"></i> Histórico completo de proprietários e veículos</li>
                                <li><i class="fa-solid fa-circle-check"></i> Busca instantânea e organização sem duplicidades</li>
                            </ul>
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Testar 15 dias grátis</Button>
                        </div>
                        <div class="tab-visual-side">
                            <img src="/assets/images/Cadastros.png" alt="Gestão de Cadastros" loading="lazy">
                        </div>
                    </div>

                    <!-- Tab 2: Ordens de Serviço -->
                    <div class="tab-panel" id="tab-os">
                        <div class="tab-text-side">
                            <h3>📋 Ordens de Serviço & Processos</h3>
                            <p>
                                Acompanhe e gerencie todas as <strong>Ordens de Serviço em tempo real</strong>. Controle cada etapa dos processos dos seus clientes, valores cobrados, taxas estaduais e status de conclusão.
                            </p>
                            <ul class="tab-topics-list">
                                <li><i class="fa-solid fa-circle-check"></i> Emissão rápida de Ordens de Serviço personalizadas</li>
                                <li><i class="fa-solid fa-circle-check"></i> Controle de prazos, taxas e etapas do processo</li>
                                <li><i class="fa-solid fa-circle-check"></i> Histórico transparente para o atendimento do seu escritório</li>
                            </ul>
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Testar 15 dias grátis</Button>
                        </div>
                        <div class="tab-visual-side">
                            <img src="/assets/images/ordens-de-servico.png" alt="Ordens de Serviço" loading="lazy">
                        </div>
                    </div>

                    <!-- Tab 3: Documentos & Recibos -->
                    <div class="tab-panel" id="tab-documentos">
                        <div class="tab-text-side">
                            <h3>📄 Recibos & Protocolos de Entrada</h3>
                            <p>
                                Emita recibos de entrada e devolução de documentos com total rapidez. Proporcione <strong>segurança e transparência para o seu cliente</strong>, protegendo seu escritório contra qualquer tipo de extravio.
                            </p>
                            <ul class="tab-topics-list">
                                <li><i class="fa-solid fa-circle-check"></i> Recibos automáticos de entrada de documentos</li>
                                <li><i class="fa-solid fa-circle-check"></i> Protocolo de devolução assinado e organizado</li>
                                <li><i class="fa-solid fa-circle-check"></i> Rastreabilidade total das documentações de veículos</li>
                            </ul>
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Testar 15 dias grátis</Button>
                        </div>
                        <div class="tab-visual-side">
                            <img src="/assets/images/documentos.png" alt="Recibos e Documentos" loading="lazy">
                        </div>
                    </div>

                    <!-- Tab 4: Financeiro -->
                    <div class="tab-panel" id="tab-financeiro">
                        <div class="tab-text-side">
                            <h3>💰 Controle Financeiro Completo</h3>
                            <p>
                                Mantenha o caixa do seu escritório sempre equilibrado. Faça o gerenciamento de <strong>recebimentos, honorários, repasses de taxas e lucros</strong> com precisão e facilidade.
                            </p>
                            <ul class="tab-topics-list">
                                <li><i class="fa-solid fa-circle-check"></i> Lançamentos rápidos de receitas, despesas e honorários</li>
                                <li><i class="fa-solid fa-circle-check"></i> Visão clara de faturamento por período e forma de pagamento</li>
                                <li><i class="fa-solid fa-circle-check"></i> Previsão de receita e fechamento de caixa descomplicado</li>
                            </ul>
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Testar 15 dias grátis</Button>
                        </div>
                        <div class="tab-visual-side">
                            <img src="/assets/images/controle-financeiro.png" alt="Controle Financeiro" loading="lazy">
                        </div>
                    </div>

                    <!-- Tab 5: Relatórios -->
                    <div class="tab-panel" id="tab-relatorios">
                        <div class="tab-text-side">
                            <h3>📊 Relatórios Gerenciais a 1 Clique</h3>
                            <p>
                                Tome decisões estratégicas baseadas em dados reais. Exporte relatórios em <strong>PDF e planilhas de Excel</strong> de clientes, veículos, OS finalizadas e desempenho geral da empresa.
                            </p>
                            <ul class="tab-topics-list">
                                <li><i class="fa-solid fa-circle-check"></i> Relatórios em PDF e planilhas exportáveis a um clique</li>
                                <li><i class="fa-solid fa-circle-check"></i> Filtros avançados por data, cliente, atendente e status</li>
                                <li><i class="fa-solid fa-circle-check"></i> Visão panorâmica dos resultados do seu negócio</li>
                            </ul>
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Testar 15 dias grátis</Button>
                        </div>
                        <div class="tab-visual-side">
                            <img src="/assets/images/relatórios.png" alt="Relatórios Gerenciais" loading="lazy">
                        </div>
                    </div>

                    <!-- Tab 6: Consulta Veicular -->
                    <div class="tab-panel" id="tab-seguranca">
                        <div class="tab-text-side">
                            <h3>🔍 Consulta Veicular & Agilidade</h3>
                            <p>
                                Acesse informações dos veículos de forma rápida e segura. Garantimos a <strong>integração e agilidade</strong> no dia a dia do seu escritório.
                            </p>
                            <ul class="tab-topics-list">
                                <li><i class="fa-solid fa-circle-check"></i> Consulta veicular integrada e simplificada</li>
                                <li><i class="fa-solid fa-circle-check"></i> Backup diário e automático armazenado na nuvem</li>
                                <li><i class="fa-solid fa-circle-check"></i> Controle seguro do nível de permissão por usuário</li>
                            </ul>
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">Testar 15 dias grátis</Button>
                        </div>
                        <div class="tab-visual-side">
                            <img src="/assets/images/Consulta-veicular.png" alt="Consulta Veicular" loading="lazy">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Consultas & Emissões Block -->
        <section class="consultas-block-section">
            <div class="container">
                <div class="consultas-banner-card scroll-anim">
                    <div class="consultas-header">
                        <span class="consultas-badge"><i class="fa-solid fa-car-on"></i> CONSULTAS & EMISSÕES INTEGRADAS</span>
                        <h2>Consultas Veiculares & Documentos em Poucos Segundos</h2>
                        <p>Complemente a rotina do seu escritório com consultas e emissões rápidas diretamente no sistema:</p>
                    </div>

                    <div class="consultas-grid">
                        <div class="consulta-item">
                            <div class="consulta-icon"><i class="fa-solid fa-file-contract"></i></div>
                            <div class="consulta-info">
                                <h4>Emissão de CRLV-e</h4>
                                <span>Licenciamento digital rápido e seguro</span>
                            </div>
                        </div>

                        <div class="consulta-item">
                            <div class="consulta-icon"><i class="fa-solid fa-file-signature"></i></div>
                            <div class="consulta-info">
                                <h4>Emissão de ATPV-e</h4>
                                <span>Intenção de venda e transferência</span>
                            </div>
                        </div>

                        <div class="consulta-item">
                            <div class="consulta-icon"><i class="fa-solid fa-barcode"></i></div>
                            <div class="consulta-info">
                                <h4>Consulta Número do Motor</h4>
                                <span>Validação completa de motor e chassi</span>
                            </div>
                        </div>

                        <div class="consulta-item">
                            <div class="consulta-icon"><i class="fa-solid fa-shield-halved"></i></div>
                            <div class="consulta-info">
                                <h4>Consulta de Gravame</h4>
                                <span>Verificação de alienações e restrições</span>
                            </div>
                        </div>

                        <div class="consulta-item">
                            <div class="consulta-icon"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
                            <div class="consulta-info">
                                <h4>Consulta Veicular Completa</h4>
                                <span>Histórico de débitos, multas e proprietários</span>
                            </div>
                        </div>

                        <div class="consulta-item">
                            <div class="consulta-icon"><i class="fa-solid fa-bullhorn"></i></div>
                            <div class="consulta-info">
                                <h4>Comunicado de Venda</h4>
                                <span>Notificação imediata e alertas de processos</span>
                            </div>
                        </div>
                    </div>

                    <div class="consultas-cta">
                        <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">
                            Testar 15 dias grátis
                        </Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonials Section -->
        <section id="depoimentos" class="testimonials-section">

            <!-- Infinite Marquee -->
            <div class="marquee-container">
                <!-- Track 1 -->
                <div class="marquee-track">
                    <!-- Original Set -->
                    <div class="testimonial-pill">
                        <img src="https://i.pravatar.cc/100?img=1" class="testimonial-avatar" alt="Usuário">
                        <span class="testimonial-text">O Documentalista mudou completamente a forma como gerencio minha documentação!</span>
                        <i class="fa-solid fa-quote-right testimonial-quote"></i>
                    </div>
                    <div class="testimonial-pill">
                        <img src="https://i.pravatar.cc/100?img=5" class="testimonial-avatar" alt="Usuário">
