---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { blogPosts } from '../data/blogPosts';
---

<Layout
    title="Blog do Documentalista - Artigos e Dicas para Despachantes de Veículos"
    description="Conteúdos práticos, novidades sobre legislação veicular, dicas de gestão e tecnologia para despachantes de veículos e vistorias."
>
    <main class="blog-page">
        <!-- Hero Section do Blog -->
        <section class="blog-hero">
            <div class="container text-center">
                <span class="blog-badge">
                    <i class="fa-solid fa-newspaper"></i> BLOG DOCUMENTALISTA
                </span>
                <h1>
                    Conteúdos e Dicas para <span class="gradient-text">Despachantes de Veículos</span>
                </h1>
                <p class="subheadline">
                    Acompanhe artigos exclusivos sobre gestão, tecnologia, legislação e estratégias de crescimento para o seu escritório.
                </p>

                <!-- Categorias de filtro visual -->
                <div class="blog-categories">
                    <span class="category-chip active">Todos</span>
                    <span class="category-chip">Gestão</span>
                    <span class="category-chip">Tecnologia</span>
                    <span class="category-chip">Legislação</span>
                    <span class="category-chip">Vendas</span>
                </div>
            </div>
        </section>

        <!-- Grade de Artigos -->
        <section class="blog-content-section">
            <div class="container">
                <div class="blog-grid">
                    {blogPosts.map((post) => (
                        <article class="blog-card">
                            <a href={`/blog/${post.slug}`} class="blog-card-media-link">
                                <div class="blog-card-media">
                                    <img
                                        src={post.image}
                                        alt={post.title}
                                        loading="lazy"
                                        class="blog-card-img"
                                    />
                                    <span class="blog-card-category">{post.category}</span>
                                </div>
                            </a>

                            <div class="blog-card-body">
                                <div class="blog-card-meta">
                                    <span class="meta-item">
                                        <i class="fa-regular fa-calendar"></i> {post.date}
                                    </span>
                                    <span class="meta-item">
                                        <i class="fa-regular fa-clock"></i> {post.readTime}
                                    </span>
                                </div>

                                <h2 class="blog-card-title">
                                    <a href={`/blog/${post.slug}`}>
                                        {post.title}
                                    </a>
                                </h2>

                                <p class="blog-card-excerpt">
                                    {post.excerpt}
                                </p>

                                <div class="blog-card-footer">
                                    <div class="author-info">
                                        <i class="fa-solid fa-user-pen"></i>
                                        <span>{post.author}</span>
                                    </div>
                                    <a href={`/blog/${post.slug}`} class="read-more-link">
                                        Ler artigo <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA Newsletter / Teste Grátis -->
        <section class="blog-cta-section">
            <div class="container">
                <div class="blog-cta-card">
                    <div class="blog-cta-content">
                        <span class="badge-gold">
                            <i class="fa-solid fa-award"></i> +10 ANOS DE EXPERIÊNCIA
                        </span>
                        <h2>Leve a gestão do seu escritório a outro nível</h2>
                        <p>
                            Faça como centenas de despachantes de todo o Brasil: simplifique ordens de serviço, recibos, consultas e o financeiro em uma única plataforma online.
                        </p>
                        <div class="blog-cta-buttons">
                            <Button href="https://app.documentalista.com.br/tenants/register" target="_blank" variant="primary">
                                Testar 15 dias grátis <i class="fa-solid fa-arrow-right"></i>
                            </Button>
                            <Button href="https://wa.me/5547991278324" target="_blank" variant="outline">
                                Falar no WhatsApp
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .blog-page {
        padding-top: 6rem;
        padding-bottom: 4rem;
        position: relative;
        z-index: 1;
    }

    .blog-hero {
        padding: 4rem 0 3rem 0;
        text-align: center;
    }

    .blog-hero .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .blog-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(61, 181, 180, 0.12);
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.45rem 1.2rem;
        border-radius: 9999px;
        margin: 0 auto 1.25rem auto;
        border: 1px solid rgba(61, 181, 180, 0.25);
    }

    .blog-hero h1 {
        font-size: 2.75rem;
        font-weight: 800;
        line-height: 1.2;
        max-width: 820px;
        margin: 0 auto 1.2rem auto;
        color: var(--color-secondary);
        text-align: center;
    }

    .blog-hero .subheadline {
        max-width: 680px;
        margin: 0 auto 2.5rem auto;
        color: var(--text-muted);
        font-size: 1.15rem;
        line-height: 1.6;
        text-align: center;
    }

    .blog-categories {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .category-chip {
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(18, 74, 110, 0.12);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-chip:hover {
        color: var(--color-secondary);
        border-color: var(--color-primary);
        background: #ffffff;
        transform: translateY(-2px);
    }

    .category-chip.active {
        background: var(--color-secondary);
        color: #ffffff;
        border-color: var(--color-secondary);
        box-shadow: 0 4px 12px rgba(18, 74, 110, 0.2);
    }

    /* Grade de Artigos */
    .blog-content-section {
        padding: 2rem 0 5rem 0;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.25rem;
    }

    .blog-card {
        background: #ffffff;
        border-radius: 1.25rem;
        overflow: hidden;
        border: 1px solid rgba(18, 74, 110, 0.08);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        transition: all 0.4s var(--ease-premium, cubic-bezier(0.16, 1, 0.3, 1));
    }

    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -15px rgba(18, 74, 110, 0.15);
        border-color: rgba(61, 181, 180, 0.35);
    }

    .blog-card-media-link {
        display: block;
        text-decoration: none;
        overflow: hidden;
    }

    .blog-card-media {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: #f1f5f9;
    }

    .blog-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease-premium, cubic-bezier(0.16, 1, 0.3, 1));
    }

    .blog-card:hover .blog-card-img {
        transform: scale(1.08);
    }

    .blog-card-category {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: rgba(18, 74, 110, 0.9);
        backdrop-filter: blur(8px);
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .blog-card-body {
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .blog-card-meta {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 0.85rem;
    }

    .blog-card-meta .meta-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .blog-card-meta i {
        color: var(--color-primary);
    }

    .blog-card-title {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.45;
        margin-bottom: 0.85rem;
        color: var(--color-secondary);
    }

    .blog-card-title a {
        color: inherit;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .blog-card-title a:hover {
        color: var(--color-primary);
    }

    .blog-card-excerpt {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .blog-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(18, 74, 110, 0.08);
        padding-top: 1.25rem;
        margin-top: auto;
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-secondary);
    }

    .author-info i {
        color: var(--color-primary);
    }

    .read-more-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .read-more-link:hover {
        color: var(--color-secondary);
        transform: translateX(4px);
    }

    /* CTA Section */
    .blog-cta-section {
        padding: 2rem 0 4rem 0;
    }

    .blog-cta-card {
        background: linear-gradient(135deg, #124A6E 0%, #0F3D5A 100%);
        border-radius: 1.5rem;
        padding: 4rem 2.5rem;
        text-align: center;
        color: #ffffff;
        box-shadow: 0 25px 50px -12px rgba(18, 74, 110, 0.25);
        position: relative;
        overflow: hidden;
    }

    .blog-cta-content {
        max-width: 720px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .badge-gold {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 180, 0, 0.15);
        color: #FFB400;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        padding: 0.4rem 1.2rem;
        border-radius: 9999px;
        margin-bottom: 1.2rem;
        border: 1px solid rgba(255, 180, 0, 0.3);
    }

    .blog-cta-card h2 {
        font-size: 2.25rem;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 1rem;
        color: #ffffff;
    }

    .blog-cta-card p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 2rem;
    }

    .blog-cta-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .blog-cta-buttons :global(.btn-outline) {
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff;
    }

    .blog-cta-buttons :global(.btn-outline:hover) {
        border-color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }

    /* Responsividade */
    @media (max-width: 1024px) {
        .blog-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.75rem;
        }

        .blog-hero h1 {
            font-size: 2.25rem;
        }
    }

    @media (max-width: 640px) {
        .blog-grid {
            grid-template-columns: 1fr;
        }

        .blog-hero h1 {
            font-size: 1.85rem;
        }

        .blog-hero .subheadline {
            font-size: 1rem;
        }

        .blog-cta-card {
            padding: 2.5rem 1.5rem;
        }

        .blog-cta-card h2 {
            font-size: 1.65rem;
        }
    }
</style>
